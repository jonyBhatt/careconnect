generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PATIENT
  COMPANION
  ADMIN
}

enum ServiceType {
  STAY
  CAREGIVING
  MEDICINE_PICKUP
  PICK_AND_DROP
}

enum BookingStatus {
  REQUESTED // patient submitted, waiting on admin
  OFFERED // admin offered to a companion, awaiting confirmation call
  CONFIRMED // companion confirmed with admin
  EN_ROUTE // companion traveling to patient/pharmacy
  IN_PROGRESS // checked in, session active
  COMPLETED // checked out, session finished
  CANCELLED_PATIENT
  CANCELLED_COMPANION
  DISPUTED
}

enum CompanionVerificationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum CompanionCertification {
  BASIC // stay-only tier
  CAREGIVING_CERT // CNA-style / caregiving trained
  DRIVER_VERIFIED // valid license + vehicle for pick-and-drop
}

enum PaymentLineItemType {
  COMPANION_TIME
  MEDICINE_PLATFORM_PORTION
  MEDICINE_CASH_PORTION
  PLATFORM_FEE
  DISPATCH_FEE // late-cancel / no-show minimum fee
  REFUND
}

enum PaymentStatus {
  PENDING
  HELD_IN_ESCROW
  RELEASED
  REFUNDED
  DISPUTED
}

enum PrescriptionReviewStatus {
  PENDING
  APPROVED
  FLAGGED_CONTROLLED_SUBSTANCE
  REJECTED
}

enum ReceiptUploadedBy {
  COMPANION
  PATIENT
}

enum StrikeReason {
  NO_SHOW
  LATE_ARRIVAL
  RECEIPT_MISMATCH
  SAFETY_COMPLAINT
  CASH_DISPUTE
  OTHER
}

enum StrikeTargetType {
  COMPANION
  PATIENT
}

enum LocationSource {
  PATIENT
  COMPANION
}

enum SosTriggeredBy {
  PATIENT
  COMPANION
}

enum SosStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

// ------------------------------------------------------------
// CORE USER MODELS
// ------------------------------------------------------------

model User {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  role          UserRole @default(PATIENT)
  phone         String?
  phoneVerified Boolean  @default(false)
  name          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  patientProfile   Patient?
  companionProfile Companion?
  adminProfile     Admin?

  email               String
  emailVerified       Boolean @default(false)
  image               String?
  onboardingCompleted Boolean @default(false)

  sessions Session[]
  accounts Account[]

  @@unique([email])
  @@index([role])
  @@map("user")
}

model Admin {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  user       User      @relation(fields: [userId], references: [id])
  userId     String    @unique @db.ObjectId
  onCallFrom DateTime?
  onCallTo   DateTime?
  createdAt  DateTime  @default(now())

  // dispatchedBookings AdminDispatchLog[]
  // relayMessages      RelayMessage[]
  // sosResponses       SosAlert[]
}

model Patient {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  user                  User     @relation(fields: [userId], references: [id])
  userId                String   @unique @db.ObjectId
  address               String
  medicalName           String?
  emergencyContactName  String?
  emergencyContactPhone String?
  safetyNotes           String? // mobility issues, allergies relevant to companion safety - NOT diagnostic
  managedByRelation     String? // e.g. "son", "daughter" if booking on behalf of someone else
  locationConsentGiven  Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  bookings          Booking[]
  ratingsGiven      Rating[]           @relation("PatientRatingsGiven")
  ratingsReceived   Rating[]           @relation("PatientRatingsReceived")
  // strikesReceived   Strike[]           @relation("PatientStrikes")
  cashConfirmations CashConfirmation[]
}

model Companion {
  id                    String                      @id @default(auto()) @map("_id") @db.ObjectId
  user                  User                        @relation(fields: [userId], references: [id])
  userId                String                      @unique @db.ObjectId
  verificationStatus    CompanionVerificationStatus @default(PENDING)
  idDocumentUrl         String?
  selfieUrl             String?
  documentUploads       Json?
  backgroundCheckStatus String?
  drivingLicenseUrl     String?
  vehicleInfo           String?
  vehicleInsuranceUrl   String?
  serviceRadiusKm       Float?
  latitude              Float?
  longitude             Float?
  locationConsentGiven  Boolean                     @default(false)
  bankOrWalletDetails   String?
  strikeCount           Float                       @default(0)
  averageRating         Float?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  certifications    CompanionCertificationRecord[]
  availability      CompanionAvailability[]
  bookings          Booking[]
  ratingsGiven      Rating[]                       @relation("CompanionRatingsGiven")
  ratingsReceived   Rating[]                       @relation("CompanionRatingsReceived")
  // strikesReceived   Strike[]                       @relation("CompanionStrikes")
  // dispatchOffers    AdminDispatchLog[]
  // cashConfirmations CashConfirmation[]
  cashConfirmations CashConfirmation[]
  // strikes           Strike[]

  @@index([verificationStatus])
  @@index([latitude, longitude])
}

model CompanionCertificationRecord {
  id            String                 @id @default(auto()) @map("_id") @db.ObjectId
  companion     Companion              @relation(fields: [companionId], references: [id])
  companionId   String                 @db.ObjectId
  certification CompanionCertification
  documentUrl   String?
  approvedAt    DateTime?
  createdAt     DateTime               @default(now())

  @@unique([companionId, certification])
}

model CompanionAvailability {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  companion   Companion @relation(fields: [companionId], references: [id])
  companionId String    @db.ObjectId
  dayOfWeek   Int // 0-6
  startTime   String // "09:00"
  endTime     String // "18:00"

  @@index([companionId])
}

// ------------------------------------------------------------
// BOOKING
// ------------------------------------------------------------

model Booking {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  patient     Patient    @relation(fields: [patientId], references: [id])
  patientId   String     @db.ObjectId
  companion   Companion? @relation(fields: [companionId], references: [id])
  companionId String?    @db.ObjectId

  serviceTypes ServiceType[] // supports combined bookings e.g. [STAY, MEDICINE_PICKUP]
  status       BookingStatus @default(REQUESTED)

  scheduledStart   DateTime
  scheduledEnd     DateTime
  actualCheckInAt  DateTime?
  actualCheckOutAt DateTime?

  // Pick-and-drop specific
  pickupAddress  String?
  pickupLat      Float?
  pickupLng      Float?
  dropoffAddress String?
  dropoffLat     Float?
  dropoffLng     Float?

  // Caregiving specific
  authorizedTasks String? // checklist captured at booking, e.g. "walking assistance only, no lifting"

  cancelledAt            DateTime?
  cancelledBy            UserRole?
  cancellationFeeApplied Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prescription     Prescription?
  payments         PaymentLineItem[]
  receipts         Receipt[]
  cashConfirmation CashConfirmation?
  locationPings    LocationPing[]
  // dispatchLog      AdminDispatchLog[]
  // relayMessages    RelayMessage[]
  // sosAlerts        SosAlert[]
  ratings          Rating[]
  // strikes          Strike[]

  @@index([status])
  @@index([patientId])
  @@index([companionId])
  @@index([scheduledStart])
}

