// ------------------------------------------------------------
// MEDICINE / PRESCRIPTION
// ------------------------------------------------------------

model Prescription {
  id                String                   @id @default(auto()) @map("_id") @db.ObjectId
  booking           Booking                  @relation(fields: [bookingId], references: [id])
  bookingId         String                   @unique @db.ObjectId
  imageUrl          String
  reviewStatus      PrescriptionReviewStatus @default(PENDING)
  estimatedCost     Float?
  reviewedByAdminAt DateTime?
  createdAt         DateTime                 @default(now())
}

model Receipt {
  id         String            @id @default(auto()) @map("_id") @db.ObjectId
  booking    Booking           @relation(fields: [bookingId], references: [id])
  bookingId  String            @db.ObjectId
  uploadedBy ReceiptUploadedBy
  imageUrl   String
  amount     Float?
  createdAt  DateTime          @default(now())

  @@index([bookingId])
}

// Records the 40% cash-on-delivery portion when medicine total > 500tk

model CashConfirmation {
  id                         String     @id @default(auto()) @map("_id") @db.ObjectId
  booking                    Booking    @relation(fields: [bookingId], references: [id])
  bookingId                  String     @unique @db.ObjectId
  amountExpected             Float
  amountConfirmedByCompanion Float?
  companion                  Companion? @relation(fields: [companionId], references: [id])
  companionId                String?    @db.ObjectId
  amountConfirmedByPatient   Float?
  patient                    Patient?   @relation(fields: [patientId], references: [id])
  patientId                  String?    @db.ObjectId
  confirmedAt                DateTime?
  disputed                   Boolean    @default(false)
}

// ------------------------------------------------------------
// PAYMENTS / ESCROW
// ------------------------------------------------------------

model PaymentLineItem {
  id           String              @id @default(auto()) @map("_id") @db.ObjectId
  booking      Booking             @relation(fields: [bookingId], references: [id])
  bookingId    String              @db.ObjectId
  type         PaymentLineItemType
  amount       Float
  status       PaymentStatus       @default(PENDING)
  escrowHeldAt DateTime?
  releasedAt   DateTime?
  refundedAt   DateTime?
  disputeNotes String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([bookingId])
  @@index([status])
}

// ------------------------------------------------------------
// LIVE LOCATION
// ------------------------------------------------------------

model LocationPing {
  id         String         @id @default(auto()) @map("_id") @db.ObjectId
  booking    Booking        @relation(fields: [bookingId], references: [id])
  bookingId  String         @db.ObjectId
  source     LocationSource
  latitude   Float
  longitude  Float
  recordedAt DateTime       @default(now())

  @@index([bookingId, recordedAt])
}

// ------------------------------------------------------------
// RATINGS & STRIKES
// ------------------------------------------------------------

model Rating {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  booking   Booking  @relation(fields: [bookingId], references: [id])
  bookingId String   @db.ObjectId
  score     Int // 1-5
  comment   String?
  createdAt DateTime @default(now())

  // one of these pairs will be set depending on direction of rating
  ratingPatient   Patient? @relation("PatientRatingsGiven", fields: [ratingPatientId], references: [id])
  ratingPatientId String?  @db.ObjectId
  ratedPatient    Patient? @relation("PatientRatingsReceived", fields: [ratedPatientId], references: [id])
  ratedPatientId  String?  @db.ObjectId

  ratingCompanion   Companion? @relation("CompanionRatingsGiven", fields: [ratingCompanionId], references: [id])
  ratingCompanionId String?    @db.ObjectId
  ratedCompanion    Companion? @relation("CompanionRatingsReceived", fields: [ratedCompanionId], references: [id])
  ratedCompanionId  String?    @db.ObjectId

  @@index([bookingId])
}

